rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Marta Fitness — Firestore security rules
//
// Model: exactly one privileged role (the trainer) and many clients. A client
// may only ever see and touch their own data; the trainer sees everything for
// her own clients. Nothing here trusts a field the client controls — role and
// status are writable by the trainer only, so a client cannot self-approve or
// promote themselves by editing their own user document.
//
// RE-BRANDING FOR ANOTHER TRAINER: change trainerEmails() below and redeploy.
// Keep it in sync with EXPO_PUBLIC_ADMIN_EMAIL (backend/config/tenant.js) —
// that one only drives the UI, this one is what is actually enforced.
//
// Deploy:  firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Identity helpers ───────────────────────────────────────────────────

    function trainerEmails() {
      return ['danielrajic145@gmail.com'];
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Verified e-mail only: an unverified address could otherwise be spoofed by
    // a provider that does not check ownership.
    function isTrainer() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in trainerEmails();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // A client only gets past the waiting room once the trainer approves them.
    function isActiveClient() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Booking is for clients who train in person. An approved online client
    // has no business holding a slot on the trainer's calendar.
    function isInPersonClient() {
      return isActiveClient()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('trainingType', null) == 'in_person';
    }

    // A field that is absent, null, or a string no longer than `max`.
    function isOptionalString(data, field, max) {
      return data.get(field, null) == null
        || (data[field] is string && data[field].size() <= max);
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    // A client reads and updates only their own profile, and may never change
    // the fields that decide what they are allowed to do.

    match /users/{uid} {
      allow get: if isOwner(uid) || isTrainer();
      allow list: if isTrainer();

      // Self-registration: the account is created as a pending client with no
      // training type yet, full stop. The trainer's own account is created as
      // an approved admin. Only the fields AuthContext writes are accepted —
      // the trainer's client list loads every one of these documents.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'photoURL', 'role', 'status',
             'trainingType', 'createdAt', 'lastLogin'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && isOptionalString(request.resource.data, 'displayName', 100)
        && isOptionalString(request.resource.data, 'photoURL', 2048)
        && request.resource.data.get('trainingType', null) == null
        && (
          isTrainer()
            ? (request.resource.data.role == 'admin'
               && request.resource.data.status == 'active')
            : (request.resource.data.role == 'user'
               && request.resource.data.status == 'pending')
        );

      // What a client may change on her own profile: the login refresh (name,
      // photo, last login) and, once, her training type.
      //
      // Only the *changed* keys are checked, so an older document carrying a
      // field this list does not name still accepts the login refresh.
      //
      // The training type is open while she waits for approval (so a wrong
      // pick can be corrected) and frozen once she is approved: it decides
      // whether she can book the trainer's calendar, which the trainer agreed
      // to when she approved her. The trainer can still change it.
      function ownerProfileUpdateOk() {
        let after = request.resource.data;
        let changed = after.diff(resource.data).affectedKeys();
        return changed.hasOnly(['displayName', 'photoURL', 'lastLogin', 'trainingType'])
          && (!changed.hasAny(['displayName']) || isOptionalString(after, 'displayName', 100))
          && (!changed.hasAny(['photoURL']) || isOptionalString(after, 'photoURL', 2048))
          && (!changed.hasAny(['lastLogin']) || after.lastLogin == request.time)
          && (!changed.hasAny(['trainingType'])
              || (after.get('trainingType', null) in ['online', 'in_person']
                  && (resource.data.get('status', null) == 'pending'
                      || resource.data.get('trainingType', null) == null)));
      }

      allow update: if isTrainer() || (isOwner(uid) && ownerProfileUpdateOk());

      allow delete: if isTrainer();
    }

    // ─── Appointments ───────────────────────────────────────────────────────
    // One document per bookable slot, with the document id pinned to
    // "<date>_<time>". That is what makes a double-booking impossible: two
    // clients racing for the same minute race for the same document, and only
    // one create can win.

    match /appointments/{slotId} {

      function slotIdMatchesData() {
        return slotId == request.resource.data.appointmentDate + '_' + request.resource.data.time;
      }

      function wellFormedSlot() {
        return request.resource.data.userId is string
          && request.resource.data.appointmentDate is string
          && request.resource.data.appointmentDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && request.resource.data.time is string
          && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.status in ['active', 'cancelled']
          && slotIdMatchesData();
      }

      // The slot start, rebuilt from the two string fields of `data`.
      //
      // timestamp.date() is UTC while the app books in local time, so for a
      // UTC+1/+2 trainer this lands 1–2h AFTER the real start. That makes the
      // deadline below slightly *looser* than 24h, never tighter — the backstop
      // can never wrongly refuse a legitimate cancellation. The exact 24h rule
      // is enforced in the app and re-checked inside the write transaction;
      // this exists so a tampered client still cannot cancel an hour before.
      function slotStartOf(data) {
        return timestamp.date(
            int(data.appointmentDate[0:4]),
            int(data.appointmentDate[5:7]),
            int(data.appointmentDate[8:10])
          )
          + duration.value(int(data.time[0:2]), 'h')
          + duration.value(int(data.time[3:5]), 'm');
      }

      function beforeCancellationDeadline() {
        return resource.data.appointmentDate is string
          && resource.data.appointmentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && resource.data.time is string
          && resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
          && request.time < slotStartOf(resource.data) - duration.value(24, 'h');
      }

      // A client books the coming week only (the app offers next Mon–Fri, at
      // most ~12 days out), never the past and never months ahead. Same UTC
      // slack as above: a slot that started up to 2h ago still passes, which
      // gains nobody anything.
      function inBookingWindow() {
        return request.time < slotStartOf(request.resource.data)
          && slotStartOf(request.resource.data) < request.time + duration.value(15, 'd');
      }

      // Clients need the whole week's slots to know what is still free. The
      // document deliberately carries no name or photo, so this exposes nothing
      // beyond an opaque uid — and only to clients who book at all.
      allow read: if isTrainer() || isInPersonClient();

      allow create: if wellFormedSlot()
        && request.resource.data.status == 'active'
        && request.resource.data.keys().hasOnly([
             'userId', 'appointmentDate', 'time', 'status',
             'createdAt', 'updatedAt', 'cancelledAt'])
        && (isTrainer()
            || (isInPersonClient()
                && isOwner(request.resource.data.userId)
                && inBookingWindow()));

      allow update: if isTrainer()
        // Client releases their own slot, but only up to 24h before it starts.
        // The trainer is not bound by the deadline — she can always free a slot.
        || (isOwner(resource.data.userId)
            && request.resource.data.status == 'cancelled'
            && beforeCancellationDeadline()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'cancelledAt', 'updatedAt']))
        // Client claims a slot somebody else released.
        || (isInPersonClient()
            && resource.data.status == 'cancelled'
            && wellFormedSlot()
            && request.resource.data.status == 'active'
            && isOwner(request.resource.data.userId)
            && inBookingWindow()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['userId', 'status', 'createdAt', 'updatedAt', 'cancelledAt']));

      allow delete: if isTrainer();
    }

    // ─── Weekly reviews (impressions) ───────────────────────────────────────
    // Private reflections. Previously any signed-in user could read every
    // client's entries.

    match /weekly_review/{docId} {
      // Every star rating is a whole number from 1 to 5, and all three
      // categories are rated — nothing else can end up in front of the trainer.
      function isStar(v) {
        return v is int && v >= 1 && v <= 5;
      }

      function validRatings(r) {
        return r is map
          && r.keys().hasOnly(['training', 'eating', 'communication'])
          && r.keys().hasAll(['training', 'eating', 'communication'])
          && isStar(r.training)
          && isStar(r.eating)
          && isStar(r.communication);
      }

      allow read: if isTrainer() || isOwner(resource.data.userId);

      // The date is the server's, not the phone's, so a review cannot be
      // back- or forward-dated; the reflection is capped like its text box.
      allow create: if isActiveClient()
        && isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
             'userId', 'userName', 'ratings', 'reflection', 'createdAt'])
        && validRatings(request.resource.data.ratings)
        && request.resource.data.reflection is string
        && request.resource.data.reflection.size() <= 2000
        && isOptionalString(request.resource.data, 'userName', 100)
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isTrainer();
    }

    // ─── Shared validation ─────────────────────────────────────────────────

    function isDateString(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A measurement value as typed: empty, or a short number-ish string.
    function isShortValue(data, field) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= 8);
    }

    // Whether `id` is prefixed "<uid>_" — true regardless of whether the
    // document exists.
    //
    // A read rule that instead says `isOwner(resource.data.userId)` looks
    // right, but `resource` is null when the document does not exist yet, and
    // `resource.data` on null does not evaluate to false — it aborts rule
    // evaluation, which Firestore reports to the client as a bare permission
    // error. That bites exactly the read-before-write these collections do:
    // logging a set for an exercise for the first time reads its (not yet
    // existing) document before writing it. Since every id here already
    // encodes its owner, ownership can be read off the id itself, which needs
    // no document to exist.
    function idBelongsToCaller(id) {
      return isSignedIn()
        && id.size() > request.auth.uid.size()
        && id[0:request.auth.uid.size()] == request.auth.uid
        && id[request.auth.uid.size():request.auth.uid.size() + 1] == '_';
    }

    // ─── Measurements (client check-ins) ────────────────────────────────────
    // Body data. The client enters her own — the trainer cannot measure an
    // online client — and the trainer reads it. Id pinned to "<uid>_<date>",
    // so one entry per day and nobody can write under someone else's uid.

    match /measurements/{docId} {
      // Split, deliberately, from a single `allow read`. A get (including the
      // "does this date already have an entry?" check before a create) can
      // rely on idBelongsToCaller, since the id is known whether or not the
      // document exists. A list (the query useClientMeasurements runs) only
      // ever returns existing documents, but Firestore has to prove the rule
      // holds for the whole query using its where-clauses alone — it cannot
      // look inside a result's id to do that, so a list needs the ownership
      // check on the document's data instead.
      allow get: if isTrainer() || idBelongsToCaller(docId);
      allow list: if isTrainer() || resource.data.userId == request.auth.uid;

      allow create, update: if isActiveClient()
        && isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
             'userId', 'date', 'weight', 'waist', 'hips', 'chest', 'arms',
             'photoAngles', 'updatedAt'])
        && isDateString(request.resource.data.date)
        && docId == request.auth.uid + '_' + request.resource.data.date
        && isShortValue(request.resource.data, 'weight')
        && isShortValue(request.resource.data, 'waist')
        && isShortValue(request.resource.data, 'hips')
        && isShortValue(request.resource.data, 'chest')
        && isShortValue(request.resource.data, 'arms')
        && (!('photoAngles' in request.resource.data)
            || (request.resource.data.photoAngles is list
                && request.resource.data.photoAngles.size() <= 4
                && request.resource.data.photoAngles.hasOnly(['front', 'back', 'left', 'right'])))
        && (resource == null || resource.data.userId == request.auth.uid);

      allow delete: if isTrainer() || idBelongsToCaller(docId);
    }

    // ─── Progress photos ────────────────────────────────────────────────────
    // The most sensitive data in the app. One document per photo, id pinned
    // to "<uid>_<date>_<angle>" with the angle limited to four values — which
    // is what caps a check-in at four photos, structurally rather than by
    // trusting the client. Content must be a JPEG under the size cap.

    match /progress_photos/{photoId} {
      // Same get/list split as measurements, for the same reason: useCheckInPhotos
      // queries by userId + date.
      allow get: if isTrainer() || idBelongsToCaller(photoId);
      allow list: if isTrainer() || resource.data.userId == request.auth.uid;

      allow create, update: if isActiveClient()
        && isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
             'userId', 'date', 'angle', 'mimeType', 'data', 'createdAt'])
        && isDateString(request.resource.data.date)
        && request.resource.data.angle in ['front', 'back', 'left', 'right']
        && photoId == request.auth.uid + '_' + request.resource.data.date
                      + '_' + request.resource.data.angle
        && request.resource.data.mimeType == 'image/jpeg'
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 700000
        // Base64 of the JPEG start-of-image marker; rejects arbitrary payloads.
        && request.resource.data.data[0:4] == '/9j/'
        && (resource == null || resource.data.userId == request.auth.uid);

      allow delete: if isTrainer() || idBelongsToCaller(photoId);
    }

    // ─── Exercise logs (weights the client lifted) ──────────────────────────
    // Written by the client after a training, read by the trainer when
    // planning the next one. Id pinned to "<uid>_<exerciseId>".

    match /exercise_logs/{logId} {
      // Same get/list split as measurements. get must tolerate a not-yet-
      // existing document: the save transaction reads it first (to fold in
      // history) before the first log for an exercise is ever written. list
      // is what useExerciseLogs queries with.
      allow get: if isTrainer() || idBelongsToCaller(logId);
      allow list: if isTrainer() || resource.data.userId == request.auth.uid;

      allow create, update: if isActiveClient()
        && isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly([
             'userId', 'exerciseId', 'exerciseName', 'lastSets', 'lastWeekStart',
             'lastTrainingNumber', 'history', 'updatedAt'])
        && request.resource.data.exerciseId is string
        && logId == request.auth.uid + '_' + request.resource.data.exerciseId
        && request.resource.data.lastSets is list
        && request.resource.data.lastSets.size() <= 10
        && request.resource.data.history is list
        && request.resource.data.history.size() <= 20
        && (!('exerciseName' in request.resource.data)
            || (request.resource.data.exerciseName is string
                && request.resource.data.exerciseName.size() <= 120))
        && (resource == null || resource.data.userId == request.auth.uid);

      allow delete: if isTrainer() || idBelongsToCaller(logId);
    }

    // ─── Workout programs ───────────────────────────────────────────────────

    match /workouts/{docId} {
      allow read: if isTrainer() || isOwner(resource.data.userId);
      allow write: if isTrainer();
    }

    // ─── Exercise video catalogue ───────────────────────────────────────────
    // Moved out of the source tree so the trainer can add a video without a
    // rebuild, and so the (often unlisted) YouTube ids stay out of the repo.
    // Kept behind approval for the same reason the video screens are.

    match /videos/{videoId} {
      allow read: if isTrainer() || isActiveClient();
      allow write: if isTrainer();
    }

    // ─── Trainer configuration (schedule, etc.) ─────────────────────────────
    // Approved clients read it to see availability; only the trainer writes.
    // Someone still in the waiting room has no use for the trainer's week.

    match /config/{docId} {
      allow read: if isTrainer() || isActiveClient();
      allow write: if isTrainer();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
